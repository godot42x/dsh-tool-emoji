{
  "name": "dsh-tool-emoji",
  "version": "0.3.0",
  "description": "Replace DSH tool icons with emoji (90+ tools): think 🤔, read 🧐, bash 💻, subagent 🤖, with visual picker",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godot42x/dsh-tool-emoji.git"
  },
  "homepage": "https://github.com/godot42x/dsh-tool-emoji",
  "bugs": {
    "url": "https://github.com/godot42x/dsh-tool-emoji/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "screenshots.json",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "emoji",
    "tool",
    "icon"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": ["web", "desktop"],
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^5.0.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2 || ^0.2.0",
    "react": "^18.2.0 || ^19.0.0"
  }
}
